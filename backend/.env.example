# Demonify Backend – Vorlage (lokal: als backend/.env kopieren und anpassen; siehe docs/entwicklung.md)

NODE_ENV=production
HOST=127.0.0.1
PORT=1340
PUBLIC_BASE_URL=https://demonify.thedemonlord333.me

# PostgreSQL nur lokal (oder ausdrücklich konfiguriertes privates Netz)
DATABASE_URL=postgresql://demonify:<DB_PASSWORT>@127.0.0.1:5432/demonify

# Pfade
MUSIC_DIR=/srv/music
DATA_DIR=/srv/nodeapps/demonify/data
# UPLOAD_DIR=/srv/nodeapps/demonify/data/uploads
# CACHE_DIR=/srv/nodeapps/demonify/data/cache

# Secrets – jeweils erzeugen mit:  openssl rand -base64 48
AUTH_TOKEN_SECRET=<ZUFALLSWERT_1>
STREAM_URL_SECRET=<ZUFALLSWERT_2>

# Tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
STREAM_URL_TTL_SECONDS=21600

# Medienauslieferung über Nginx (X-Accel-Redirect)
MEDIA_ACCEL_REDIRECT=true
ACCEL_PREFIX_MUSIC=/_protected/music/
ACCEL_PREFIX_CACHE=/_protected/cache/

# Nur der lokale Nginx ist vertrauenswürdiger Proxy
TRUST_PROXY=127.0.0.1,::1
# Produktion ist Same-Origin → keine CORS-Origins nötig
CORS_ORIGINS=
COOKIE_SECURE=true

# Limits
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=5 minutes
MAX_AUDIO_UPLOAD_MB=2048
MAX_IMAGE_UPLOAD_MB=30
# Abschnittsgröße – bei aktivem Cloudflare-Proxy deutlich unter 100 MB lassen
UPLOAD_CHUNK_MB=8
UPLOAD_EXPIRY_HOURS=48
TRANSCODE_CONCURRENCY=1
SCAN_CONCURRENCY=2
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

OPENAPI_UI=true
LOG_LEVEL=info
DEV_SEED_ENABLED=false
WORKER_ENABLED=true
