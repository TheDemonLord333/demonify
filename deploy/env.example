# Demonify – Serverkonfiguration (Vorlage, enthält KEINE Secrets)
# Produktiv: /srv/nodeapps/demonify/shared/.env  (Rechte 640, Besitzer root:demonify)

NODE_ENV=production
HOST=127.0.0.1
PORT=1340
PUBLIC_BASE_URL=https://demonify.thedemonlord333.me

# PostgreSQL nur lokal (oder ausdrücklich konfiguriertes privates Netz)
DATABASE_URL=postgresql://demonify:<DB_PASSWORT>@127.0.0.1:5432/demonify

# Pfade
MUSIC_DIR=/srv/music
DATA_DIR=/srv/nodeapps/demonify/data
# UPLOAD_DIR=/srv/nodeapps/demonify/data/uploads
# CACHE_DIR=/srv/nodeapps/demonify/data/cache

# Secrets – jeweils erzeugen mit:  openssl rand -base64 48
AUTH_TOKEN_SECRET=<ZUFALLSWERT_1>
STREAM_URL_SECRET=<ZUFALLSWERT_2>

# Tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
STREAM_URL_TTL_SECONDS=21600

# Medienauslieferung über Nginx (X-Accel-Redirect)
MEDIA_ACCEL_REDIRECT=true
ACCEL_PREFIX_MUSIC=/_protected/music/
ACCEL_PREFIX_CACHE=/_protected/cache/

# Nur der lokale Nginx ist vertrauenswürdiger Proxy
TRUST_PROXY=127.0.0.1,::1
# Produktion ist Same-Origin → keine CORS-Origins nötig
CORS_ORIGINS=
COOKIE_SECURE=true

# Limits
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW="5 minutes"
MAX_AUDIO_UPLOAD_MB=2048
MAX_IMAGE_UPLOAD_MB=30
# Abschnittsgröße – bei aktivem Cloudflare-Proxy deutlich unter 100 MB lassen
UPLOAD_CHUNK_MB=8
UPLOAD_EXPIRY_HOURS=48
TRANSCODE_CONCURRENCY=1
SCAN_CONCURRENCY=2
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Mailversand (E-Mail-Bestätigung, „Passwort vergessen“). Links zeigen auf PUBLIC_BASE_URL/admin/konto/…
#   disabled = kein Versand: keine E-Mail-Pflicht, kein Selbst-Reset (Admin-Reset bleibt)
#   smtp     = Produktion; log = nur Entwicklung (schreibt Links mit Token ins Log)
# Zum Aktivieren: MAIL_TRANSPORT=smtp setzen und die SMTP-Zeilen einkommentieren/ausfüllen.
MAIL_TRANSPORT=disabled
# Werte mit Leerzeichen oder <> immer in Anführungszeichen (die Datei wird auch von bash gelesen)
# MAIL_FROM="Demonify <noreply@thedemonlord333.me>"
# SMTP_HOST="smtp.example.org"
# 587 = STARTTLS (SMTP_SECURE=false, TLS wird erzwungen) · 465 = TLS (SMTP_SECURE=true)
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="noreply@thedemonlord333.me"
# SMTP_PASSWORD="<SMTP_PASSWORT>"
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24
FORGOT_RATE_LIMIT_MAX=5

OPENAPI_UI=true
LOG_LEVEL=info
DEV_SEED_ENABLED=false
WORKER_ENABLED=true
